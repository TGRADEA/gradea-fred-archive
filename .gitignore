__pycache__/
*.py[cod]
.pytest_cache/

# Generated by `python -m gradea_backtest dashboard`, ~1.1MB per build. This repo
# is a last-resort backup whose history is the vintage record, so a regenerable
# blob that changes every time the archive does does not belong in it. Rebuild
# locally; the template beside it is the source.
dashboard/data.json
dashboard/regime-desk.html

# backend/ — secrets, local state, and the snapshot store (mirrored to
# Supabase by backend/chain_snapshot_mirror.py; never committed).
backend/.env
backend/.env.*
backend/tokens.json
backend/*.token
backend/gradea.db
backend/gradea.db-*
backend/data/
backend/.venv/
backend/.ruff_cache/
