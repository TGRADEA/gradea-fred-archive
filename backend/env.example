# backend/ configuration template. Copy to backend/.env and fill in values:
#
#     cp backend/env.example backend/.env
#
# `.env` is gitignored — never commit real credentials.

# ── Schwab developer app (required for capture) ─────────────────────────────
# From https://developer.schwab.com → your app → App Key / Secret.
# Register a SEPARATE app for this project. A Schwab refresh token is
# single-use, so two programs sharing one registration revoke each other's
# session (see schwab_client.py).
SCHWAB_APP_KEY=your_schwab_app_key_here
SCHWAB_APP_SECRET=your_schwab_app_secret_here
# Required to sign in (scripts/schwab_login.py). Must match the callback
# registered on the Schwab app byte for byte. Nothing needs to listen there —
# you paste the redirect URL back into the login script.
SCHWAB_CALLBACK_URL=https://127.0.0.1:8002

# Token file. Default: <backend dir>/tokens.json. Never point this at another
# project's token file.
# SCHWAB_TOKEN_PATH=

# ── Storage (optional) ───────────────────────────────────────────────────────
# Defaults to the backend/ directory: gradea.db (SQLite manifest + config),
# tokens.json, and data/chain_snapshots/ live here.
# GRADEA_DATA_DIR=
# GRADEA_DB_PATH=

# ── Chain snapshot store (optional; defaults shown) ─────────────────────────
# Append-only option-chain snapshots. Empty GRADEA_SNAPSHOT_SYMBOLS disables
# scheduled captures (manual captures via scripts/snapshot_chains.py still work).
# GRADEA_SNAPSHOT_SYMBOLS=SPY,QQQ,IWM,DIA,SPX,VIX,GLD,USO,TLT,HYG
# GRADEA_SNAPSHOT_INTERVAL_MIN=30
# GRADEA_SNAPSHOT_MAX_DTE=120

# ── Supabase mirror (optional; off by default) ──────────────────────────────
# Off-box copy of the snapshot store. Schema: migrations/chain_snapshot_mirror_schema.sql
# (applied to project rzabvzdsbwrjzloqvrnw on 2026-09-17). The service-role key
# bypasses RLS and must stay server-side.
# SUPABASE_URL=https://rzabvzdsbwrjzloqvrnw.supabase.co
# SUPABASE_SERVICE_KEY=
# GRADEA_SNAPSHOT_MIRROR_ENABLED=1
# GRADEA_SNAPSHOT_MIRROR_INTERVAL_MIN=5
